{
  "permissions": {
    "allow": [
      "Bash(claude mcp:*)",
      "mcp__discord__reply",
      "mcp__discord__fetch_messages",
      "mcp__discord__react",
      "mcp__discord__edit_message",
      "mcp__discord__download_attachment",
      "mcp__plugin_discord_discord__reply",
      "mcp__plugin_discord_discord__fetch_messages",
      "mcp__plugin_discord_discord__react",
      "mcp__plugin_discord_discord__edit_message",
      "Skill(today)",
      "Skill(ccc-boot)",
      "Skill(ccc-heartbeat)",
      "WebSearch",
      "CronCreate",
      "CronList",
      "CronDelete",
      "Skill(ccc-handoff)",
      "Skill(ccc-jobs)"
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "node -e \"let d='';process.stdin.on('data',c=>d+=c);process.stdin.on('end',()=>{try{const j=JSON.parse(d);console.log((j.model||{}).display_name||'')}catch(e){}});\" 2>/dev/null || echo ''"
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "echo ccc-session-start"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "powershell -NonInteractive -File \"C:\\Users\\mt_wa\\projects\\agy\\scripts\\on-stop.ps1\""
          },
          {
            "type": "command",
            "command": "powershell -NonInteractive -File \"C:\\Users\\mt_wa\\projects\\agy\\scripts\\save-conversation-to-obsidian.ps1\""
          }
        ]
      }
    ]
  }
}
